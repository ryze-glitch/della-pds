rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Il Cloudflare Worker di login (vedi login.html) assegna come uid
    // Firebase "discord:<ID>", quindi va tolto il prefisso per ottenere
    // il vero ID Discord usato altrove come chiave dei documenti.
    function discordIdOf(uid) {
      return uid.split(':')[1];
    }

    // Un agente è chi ha un documento in auth-sito con quello stesso ID.
    function isAgent() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/auth-sito/$(discordIdOf(request.auth.uid)));
    }

    // Anagrafica degli agenti autorizzati ad accedere all'Area Personale.
    // Ogni documento è identificato dall'ID Discord dell'agente. Un
    // agente può leggere solo il proprio documento, per sapere
    // nome/cognome/grado; nessuna scrittura da client: i dati si
    // gestiscono a mano dalla console Firebase.
    match /auth-sito/{discordId} {
      allow read: if request.auth != null && request.auth.uid == 'discord:' + discordId;
      allow write: if false;
    }

    // Decisioni (approvato/rifiutato) sulle candidature al concorso,
    // prese dagli agenti nella pagina Gestione Candidature. Leggibili
    // da qualunque agente registrato. La prima decisione la può
    // prendere chiunque; una volta presa, solo lo stesso agente che
    // l'ha presa può cambiarla, così nessun altro può sovrascrivere
    // una valutazione già fatta.
    match /candidature-review/{decisionId} {
      allow read: if isAgent();
      allow create: if isAgent() &&
        request.resource.data.decisoDa.discordId == discordIdOf(request.auth.uid);
      allow update: if isAgent() &&
        resource.data.decisoDa.discordId == discordIdOf(request.auth.uid) &&
        request.resource.data.decisoDa.discordId == discordIdOf(request.auth.uid);
      allow delete: if false;
    }

    // Comunicati pubblici (bacheca del sito): lettura libera, scrittura solo agenti.
    match /comunicati/{id} {
      allow read: if true;
      allow create, update: if isAgent() &&
        request.resource.data.keys().hasOnly(['tipo', 'titolo', 'testo', 'data', 'creatoDa', 'creatoIl']) &&
        request.resource.data.tipo in ['Ordinanza', 'Allerta', 'Comunicato'] &&
        request.resource.data.titolo is string && request.resource.data.titolo.size() > 0 && request.resource.data.titolo.size() <= 140 &&
        request.resource.data.testo is string && request.resource.data.testo.size() <= 2000;
      allow delete: if isAgent();
    }

    // Pratiche dello Sportello Telematico. Il documento contiene SOLO lo stato
    // (nessun dato personale: i dettagli vanno solo su Discord). Si legge solo
    // conoscendo il codice univoco (get), non si può elencare dal pubblico.
    match /pratiche/{code} {
      allow get: if true;
      allow list: if isAgent();
      allow create: if code.matches('POL-[0-9]{4}-[A-HJ-NP-Z2-9]{6}') &&
        request.resource.data.keys().hasOnly(['tipo', 'stato', 'creatoIl', 'aggiornamenti']) &&
        request.resource.data.tipo in ['denuncia', 'pda', 'colloquio'] &&
        request.resource.data.stato == 'ricevuta' &&
        request.resource.data.creatoIl == request.time &&
        request.resource.data.aggiornamenti.size() == 0;
      allow update: if isAgent() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato', 'aggiornamenti', 'aggiornatoIl']) &&
        request.resource.data.stato in ['ricevuta', 'in_lavorazione', 'in_attesa', 'conclusa', 'respinta'];
      allow delete: if false;
    }

    // Stato pubblico della Questura (badge in header). Opzionale: se manca, il
    // sito ricava l'orario dello sportello. Si modifica dalla console.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
