rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anagrafica degli agenti autorizzati ad accedere all'Area Personale.
    // Ogni documento è identificato dall'ID Discord dell'agente. Il
    // Cloudflare Worker di login (vedi login.html) assegna come uid
    // Firebase "discord:<ID>", quindi il confronto aggiunge il prefisso.
    // Un agente può leggere solo il proprio documento, per sapere
    // nome/cognome/grado; nessuna scrittura da client: i dati si
    // gestiscono a mano dalla console Firebase.
    match /Auth-Sito/{discordId} {
      allow read: if request.auth != null && request.auth.uid == 'discord:' + discordId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
